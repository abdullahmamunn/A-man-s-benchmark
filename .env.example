# Environment Variables for A Man's Benchmark

# Django Security
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# PostgreSQL Database (Supabase or Neon)
# Example: postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Leave empty to automatically fall back to local SQLite for local testing
DATABASE_URL=
